{
	"name": "@343dev/guetzli",
	"version": "2.0.0",
	"description": "Guetzli JPEG encoder for Node.js, compiled to WebAssembly",
	"keywords": [
		"guetzli",
		"image-compression",
		"image",
		"img",
		"jpeg",
		"jpg",
		"optimize",
		"compress",
		"minify"
	],
	"license": "Apache-2.0",
	"author": "Andrey Warkentin (https://github.com/343dev)",
	"repository": {
		"type": "git",
		"url": "https://github.com/343dev/guetzli"
	},
	"type": "module",
	"engines": {
		"node": ">=22.22.1"
	},
	"files": [
		"dist/",
		"lib/",
		"cli.js",
		"index.js",
		"index.d.ts",
		"logo.svg",
		"MIGRATION.md",
		"UPSTREAM.md",
		"THIRD_PARTY_NOTICES.md"
	],
	"bin": {
		"guetzli": "./cli.js"
	},
	"exports": {
		".": {
			"types": "./index.d.ts",
			"node": "./index.js"
		}
	},
	"types": "./index.d.ts",
	"scripts": {
		"setup-emsdk": "./scripts/setup-emsdk.sh",
		"build:wasm": "./scripts/build-wasm.sh",
		"build:native": "./scripts/build-native.sh",
		"benchmark": "node ./scripts/benchmark.js",
		"lint": "npx eslint ./",
		"test": "node --test --test-concurrency=1",
		"test:types": "tsc --noEmit",
		"verify:upstream": "node ./scripts/verify-upstream.js",
		"verify:dist": "./scripts/verify-dist.sh",
		"verify:package": "node --test --test-concurrency=1 test/package.test.js",
		"enable-git-hooks": "git config core.hooksPath .githooks"
	},
	"devDependencies": {
		"@343dev/eslint-config": "4.0.0",
		"@types/node": "^22.20.1",
		"eslint": "9.39.2",
		"jpeg-js": "^0.4.4",
		"lint-staged": "16.2.7",
		"typescript": "^5.9.3"
	},
	"lint-staged": {
		"*.js": [
			"eslint --fix"
		]
	}
}
